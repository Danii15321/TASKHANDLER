{
  "components": {
    "schemas": {
      "AcceptedResponse": {
        "additionalProperties": false,
        "description": "Réponse `202` identique, que l'adresse soit connue ou non.",
        "properties": {
          "status": {
            "const": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "AcceptedResponse",
        "type": "object"
      },
      "AccountDeletionRequest": {
        "additionalProperties": false,
        "description": "Corps de `DELETE /users/me` : la suppression, irréversible, exige le mot de passe.",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "AccountDeletionRequest",
        "type": "object"
      },
      "AccountExport": {
        "additionalProperties": false,
        "description": "Export des données personnelles (RGPD, article 20 : droit à la portabilité).",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/UserRead"
          },
          "exported_at": {
            "format": "date-time",
            "title": "Exported At",
            "type": "string"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/ExportedSession"
            },
            "title": "Sessions",
            "type": "array"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/ExportedTask"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "exported_at",
          "account",
          "tasks",
          "sessions"
        ],
        "title": "AccountExport",
        "type": "object"
      },
      "ExportedSession": {
        "additionalProperties": false,
        "description": "Session exportée : ses dates, jamais l'empreinte du jeton.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "revocation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revocation Reason"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "required": [
          "created_at",
          "expires_at",
          "revoked_at",
          "revocation_reason"
        ],
        "title": "ExportedSession",
        "type": "object"
      },
      "ExportedTask": {
        "additionalProperties": false,
        "description": "Tâche exportée, description comprise : ce sont les données de l'utilisateur.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/ExportedTaskDay"
            },
            "title": "Days",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "created_at",
          "updated_at",
          "days"
        ],
        "title": "ExportedTask",
        "type": "object"
      },
      "ExportedTaskDay": {
        "additionalProperties": false,
        "description": "Jour d'une tâche, tel qu'exporté.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "duration_hours": {
            "title": "Duration Hours",
            "type": "integer"
          },
          "start_hour": {
            "title": "Start Hour",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "day",
          "start_hour",
          "duration_hours",
          "status",
          "completed_at"
        ],
        "title": "ExportedTaskDay",
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /auth/password/forgot`.",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "description": "Réponse minimale : une sonde publique ne doit rien révéler de l'infrastructure.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /auth/login`.",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /users/me/password` : le mot de passe actuel prouve que c'est bien le\ntitulaire, et pas seulement quelqu'un qui aurait volé un jeton d'accès.",
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeRequest",
        "type": "object"
      },
      "PlanningEntry": {
        "additionalProperties": false,
        "description": "Case de la grille : titre et position, **jamais** la description de la tâche.",
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "duration_hours": {
            "title": "Duration Hours",
            "type": "integer"
          },
          "priority": {
            "title": "Priority",
            "type": "string"
          },
          "start_hour": {
            "title": "Start Hour",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "title",
          "priority",
          "day",
          "start_hour",
          "duration_hours",
          "status"
        ],
        "title": "PlanningEntry",
        "type": "object"
      },
      "PlanningResponse": {
        "additionalProperties": false,
        "description": "Contenu de la grille pour une période.",
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/PlanningEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "entries"
        ],
        "title": "PlanningResponse",
        "type": "object"
      },
      "Problem": {
        "description": "Erreur au format RFC 9457. Ne contient jamais la valeur reçue.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "loc": {
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "type": "array"
                },
                "message": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "description": "Réponse minimale : ni version, ni hôte, ni nom de base.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /auth/register` : uniquement l'adresse et le mot de passe.\n\n`extra=\"forbid\"` refuse tout autre champ (`id`, `is_active`, `password_hash`…) : un client ne\npeut pas fixer lui-même une propriété du compte (OWASP API3, affectation de masse).",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /auth/password/reset` : le nouveau mot de passe suit la même politique.",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "TaskCreate": {
        "additionalProperties": false,
        "description": "Corps de `POST /tasks` : titre, description et de 1 à 31 jours distincts.",
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/TaskDayCreate"
            },
            "maxItems": 31,
            "minItems": 1,
            "title": "Days",
            "type": "array"
          },
          "description": {
            "maxLength": 5000,
            "title": "Description",
            "type": "string"
          },
          "priority": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "days"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskDayCreate": {
        "additionalProperties": false,
        "description": "Jour d'une tâche, donné à sa création.",
        "properties": {
          "day": {
            "format": "date",
            "ge": "2000-01-01",
            "le": "2100-12-31",
            "title": "Day",
            "type": "string"
          },
          "duration_hours": {
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Duration Hours",
            "type": "integer"
          },
          "start_hour": {
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Start Hour",
            "type": "integer"
          }
        },
        "required": [
          "start_hour",
          "duration_hours",
          "day"
        ],
        "title": "TaskDayCreate",
        "type": "object"
      },
      "TaskDayRead": {
        "additionalProperties": false,
        "description": "Vue publique d'un jour de tâche.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "duration_hours": {
            "title": "Duration Hours",
            "type": "integer"
          },
          "start_hour": {
            "title": "Start Hour",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "day",
          "start_hour",
          "duration_hours",
          "status",
          "completed_at"
        ],
        "title": "TaskDayRead",
        "type": "object"
      },
      "TaskDaySlot": {
        "additionalProperties": false,
        "description": "Créneau d'une tâche dans une journée : heure de début et durée, en heures entières.",
        "properties": {
          "duration_hours": {
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Duration Hours",
            "type": "integer"
          },
          "start_hour": {
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Start Hour",
            "type": "integer"
          }
        },
        "required": [
          "start_hour",
          "duration_hours"
        ],
        "title": "TaskDaySlot",
        "type": "object"
      },
      "TaskDayStatusUpdate": {
        "additionalProperties": false,
        "description": "Corps de `PATCH /tasks/{id}/days/{day}` : le nouveau statut, rien d'autre.\n\n`completed_at` n'en fait pas partie : il est fixé par le serveur seul.",
        "properties": {
          "status": {
            "enum": [
              "todo",
              "in_progress",
              "done",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "TaskDayStatusUpdate",
        "type": "object"
      },
      "TaskPage": {
        "additionalProperties": false,
        "description": "Une page de tâches ; `next_cursor` vaut `null` sur la dernière page.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TaskSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "TaskPage",
        "type": "object"
      },
      "TaskRead": {
        "additionalProperties": false,
        "description": "Vue publique d'une tâche, avec ses jours. `user_id` n'y figure pas : c'est le demandeur.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/TaskDayRead"
            },
            "title": "Days",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "days",
          "created_at",
          "updated_at"
        ],
        "title": "TaskRead",
        "type": "object"
      },
      "TaskSummary": {
        "additionalProperties": false,
        "description": "Élément de la liste des tâches : léger, sans description ni jours.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "priority",
          "created_at",
          "updated_at"
        ],
        "title": "TaskSummary",
        "type": "object"
      },
      "TaskUpdate": {
        "additionalProperties": false,
        "description": "Corps de `PATCH /tasks/{id}` : seuls les champs présents sont modifiés.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "priority": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "TaskUpdate",
        "type": "object"
      },
      "TokenResponse": {
        "additionalProperties": false,
        "description": "Jeton d'accès renvoyé par la connexion et le renouvellement (RFC 6749, section 5.1).\n\nLe jeton de renouvellement n'y figure pas : il voyage uniquement dans un cookie `HttpOnly`,\nhors de portée de JavaScript (voir `browser_session.py`).",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserRead": {
        "additionalProperties": false,
        "description": "Vue publique d'un compte : liste blanche des champs exposés.\n\n`password_hash`, `token_version` et `is_active` sont absents : un champ ajouté à la table\nn'apparaît dans l'API que s'il est explicitement ajouté ici (OWASP API3).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Verified At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified_at",
          "created_at"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "VerifyEmailRequest": {
        "additionalProperties": false,
        "description": "Corps de `POST /auth/verify-email` : le jeton lu par le frontend dans le lien.",
        "properties": {
          "token": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyEmailRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "TaskHandler API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "logout_all_api_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout All",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "operationId": "forgot_password_api_v1_auth_password_forgot_post",
