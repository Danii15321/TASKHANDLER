# Modèle de la configuration de l'API. Le vrai fichier `.env` n'est jamais versionné.
# Ce fichier ne contient que des valeurs factices : l'application refuse de démarrer avec elles.
# Pour le développement, `scripts/generate-dev-env.sh` crée `.env` avec des secrets aléatoires.

# Environnement : development, test ou production.
# Sans cette variable, l'application démarre en production, le mode le plus strict.
TASKHANDLER_ENVIRONMENT=development

# Niveau des journaux : DEBUG, INFO, WARNING, ERROR ou CRITICAL.
TASKHANDLER_LOG_LEVEL=INFO

# Connexion avec le rôle applicatif, le seul accepté ici. En production, ajouter `?ssl=verify-full`.
TASKHANDLER_DATABASE_URL=postgresql+asyncpg://taskhandler_app:remplacer-par-un-secret-aleatoire@127.0.0.1:55432/taskhandler
