# Modèle de la configuration de l'API. Le vrai fichier `.env` n'est jamais versionné.
# Ce fichier ne contient que des valeurs factices : l'application refuse de démarrer avec elles.
# Pour le développement, `scripts/generate-dev-env.sh` crée `.env` avec des secrets aléatoires.

# Environnement : development, test ou production.
# Sans cette variable, l'application démarre en production, le mode le plus strict.
TASKHANDLER_ENVIRONMENT=development

# Niveau des journaux : DEBUG, INFO, WARNING, ERROR ou CRITICAL.
TASKHANDLER_LOG_LEVEL=INFO

# Connexion avec le rôle applicatif, le seul accepté ici. En production, ajouter `?ssl=verify-full`.
TASKHANDLER_DATABASE_URL=postgresql+asyncpg://taskhandler_app:remplacer-par-un-secret-aleatoire@127.0.0.1:55432/taskhandler

# Redis, pour la limitation de débit, avec son utilisateur restreint. En production : `rediss://`.
TASKHANDLER_REDIS_URL=redis://taskhandler_app:remplacer-par-un-secret-aleatoire@127.0.0.1:56379/0

# Clé de signature des jetons d'accès : au moins 64 caractères aléatoires (256 bits).
# Volontairement vide ici, et donc refusée au démarrage. À générer avec : openssl rand -hex 32
TASKHANDLER_JWT_SECRET=

# Envoi des e-mails. En développement, Mailpit les garde : http://127.0.0.1:58025
# En production : SMTP_SECURITY=tls ou starttls, avec SMTP_USERNAME et SMTP_PASSWORD.
TASKHANDLER_SMTP_HOST=127.0.0.1
TASKHANDLER_SMTP_PORT=51025
TASKHANDLER_SMTP_SECURITY=none
TASKHANDLER_EMAIL_FROM=ne-pas-repondre@taskhandler.fr
# Adresse du frontend, vers laquelle pointent les liens des e-mails. En production : https://
TASKHANDLER_FRONTEND_BASE_URL=http://localhost:5173

# Facultatif. Noms d'hôte servis par l'API (`*` refusé), par défaut localhost et 127.0.0.1.
# En production, indiquer le vrai domaine : ["api.exemple.org"]
# TASKHANDLER_ALLOWED_HOSTS=["api.exemple.org"]
# Facultatif. Origines autorisées par CORS, exactes et en HTTPS hors développement ; vide = fermé.
# TASKHANDLER_CORS_ALLOWED_ORIGINS=["https://app.exemple.org"]
# Facultatif. Durées de conservation en jours (sessions, liens à usage unique, comptes non vérifiés).
# TASKHANDLER_RETENTION_SESSION_DAYS=30
# TASKHANDLER_RETENTION_ONE_TIME_TOKEN_DAYS=7
# TASKHANDLER_RETENTION_UNVERIFIED_ACCOUNT_DAYS=7
